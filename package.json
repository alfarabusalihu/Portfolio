{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env TURBOPACK=0 next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "check:models": "node scripts/check-gemini-models.js",
    "setup:auth": "node scripts/setup-google-auth.js",
    "validate": "node scripts/validate-setup.js",
    "sync:local": "npm run validate && node scripts/update-cv-data.js",
    "sync:live": "npm run validate && cross-env GENERATE_AUDIO=false node scripts/update-cv-data.js",
    "sync:monthly": "npm run validate && cross-env GENERATE_AUDIO=true node scripts/update-cv-data.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.59.4"
  },
  "optionalDependencies": {
    "canvas": "^3.2.1"
  }
