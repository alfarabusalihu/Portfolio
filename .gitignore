# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/


# production
/build
/out

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp files & extraction artifacts
*.tmp
public/*.tmp
scripts/*.tmp

# workflow logs (regenerated on each sync)
logs/*.json

# build artifacts
build.log
*.log

# generated SQL files (auto-generated from templates)
scripts/*-ready.sql

# cloudflare workers (not part of main project)
CLOUDFLARE_WORKER_*.js

# documentation & reports (generated during development)
SYSTEM_FEATURES.md
CLEANUP_REPORT.md
DEPLOYMENT_CHECKLIST.md
FINAL_SUMMARY.md
TROUBLESHOOTING.md
FIXES_APPLIED.md
ACTION_REQUIRED.md
MONGODB_LOCAL_FIX.md
FIX_DNS_WINDOWS.md
GITHUB_ACTIONS_SETUP.md
FINAL_DIAGNOSIS.md
TESS_IMPROVEMENTS.md
TESS_FINAL_UPDATES.md
test-mongodb.js
